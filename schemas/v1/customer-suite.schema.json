{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/v1/customer-suite.schema.json",
  "title": "AugmentWorks customer-owned hosted suite",
  "description": "Authoring schema for aw-suite/1 YAML or JSON files. Snake_case keys are rewritten to the camelCase canonical document before validation. Local preview is not a price and does not execute a target or an LLM.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite_id", "title", "cases"],
  "properties": {
    "schema_version": { "const": "aw-suite/1" },
    "suite_id": { "$ref": "#/$defs/identifier" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "tags": {
      "type": "array",
      "maxItems": 16,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "synthetic_only": { "const": true },
    "references": {
      "type": "array",
      "maxItems": 16,
      "items": { "$ref": "#/$defs/reference" }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": {
          "type": "string",
          "enum": [
            "approved_policy",
            "reference_answer",
            "reference_facts",
            "allowed_escalation_route",
            "synthetic_fixture_facts"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*\\.(?:md|txt)$"
        },
        "content": { "type": "string", "maxLength": 16000 }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "turns", "expected", "criteria"],
      "properties": {
        "case_id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "tags": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "turns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["content"],
            "properties": {
              "content": { "type": "string", "minLength": 1, "maxLength": 8000 }
            }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["facts"],
          "properties": {
            "facts": {
              "type": "array",
              "maxItems": 16,
              "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
            },
            "permitted_refusal": { "type": "boolean" }
          }
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/criterion" }
        },
        "observations": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key"],
            "properties": {
              "key": {
                "type": "string",
                "enum": ["policy.window_days", "policy.permitted_refusal"]
              },
              "expected": {
                "type": ["string", "number", "boolean", "null"]
              }
            }
          }
        },
        "repetitions": { "type": "integer", "minimum": 1, "maximum": 3 },
        "reference_ids": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion_id", "requirement", "kind", "statement"],
      "properties": {
        "criterion_id": { "$ref": "#/$defs/identifier" },
        "requirement": { "type": "string", "enum": ["required", "advisory"] },
        "kind": { "type": "string", "enum": ["llm_rubric", "deterministic"] },
        "statement": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "reference_ids": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "pass_conditions": {
          "type": "array",
          "maxItems": 16,
          "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
        },
        "fail_conditions": {
          "type": "array",
          "maxItems": 16,
          "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
        }
      }
    }
  }
}
