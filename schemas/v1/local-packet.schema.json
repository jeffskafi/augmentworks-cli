{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://augmentworks.ai/schemas/v1/local-packet.schema.json",
  "title": "AugmentWorks local assessment packet",
  "description": "A data-only, synthetic assessment packet executed and scored in the customer's environment.",
  "$comment": "The CLI additionally enforces namespace, uniqueness, cross-reference, aggregate-attempt, and derived-operation limits that depend on multiple fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_id",
    "version",
    "name",
    "description",
    "domain",
    "synthetic_only",
    "required_capabilities",
    "scenarios"
  ],
  "properties": {
    "schema_version": { "const": "aw-packet/0.1" },
    "packet_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "domain": { "$ref": "#/$defs/identifier160" },
    "synthetic_only": { "const": true },
    "required_capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["multi_turn", "observation", "tool_events", "cleanup"],
      "properties": {
        "multi_turn": { "type": "boolean" },
        "observation": { "type": "boolean" },
        "tool_events": { "type": "boolean" },
        "cleanup": { "type": "boolean" }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/scenario" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "identifier160": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "observationKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]*(?:\\.[A-Za-z_][A-Za-z0-9_-]*)*$"
    },
    "json": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/json" }
        },
        {
          "type": "object",
          "maxProperties": 1000,
          "propertyNames": {
            "not": { "enum": ["__proto__", "prototype", "constructor"] }
          },
          "additionalProperties": { "$ref": "#/$defs/json" }
        }
      ]
    },
    "assertionBase": {
      "type": "object",
      "required": ["key", "description"],
      "properties": {
        "key": { "$ref": "#/$defs/identifier160" },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "assertion": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "key", "description", "value"],
          "properties": {
            "kind": { "enum": ["assistant_contains", "assistant_not_contains"] },
            "key": { "$ref": "#/$defs/identifier160" },
            "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
            "value": { "type": "string", "minLength": 1, "maxLength": 8000 },
            "turn_index": { "type": "integer", "minimum": 0, "maximum": 19 },
            "case_sensitive": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "key", "description", "tool_name"],
          "properties": {
            "kind": { "const": "tool_called" },
            "key": { "$ref": "#/$defs/identifier160" },
            "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
            "tool_name": { "$ref": "#/$defs/identifier" },
            "min_calls": { "type": "integer", "minimum": 1, "maximum": 100 },
            "max_calls": { "type": "integer", "minimum": 1, "maximum": 100 },
            "arguments_contain": {
              "type": "object",
              "maxProperties": 1000,
              "additionalProperties": { "$ref": "#/$defs/json" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "key", "description", "tool_name"],
          "properties": {
            "kind": { "const": "tool_not_called" },
            "key": { "$ref": "#/$defs/identifier160" },
            "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
            "tool_name": { "$ref": "#/$defs/identifier" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "key", "description", "tool_name", "success"],
          "properties": {
            "kind": { "const": "tool_result" },
            "key": { "$ref": "#/$defs/identifier160" },
            "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
            "tool_name": { "$ref": "#/$defs/identifier" },
            "success": { "type": "boolean" },
            "output_contains": { "$ref": "#/$defs/json" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "key", "description", "observation_key"],
          "properties": {
            "kind": { "const": "observation_equals" },
            "key": { "$ref": "#/$defs/identifier160" },
            "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
            "observation_key": { "$ref": "#/$defs/observationKey" },
            "expected": { "$ref": "#/$defs/json" },
            "authoritative_only": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "key", "description", "observation_key"],
          "properties": {
            "kind": { "const": "observation_absent" },
            "key": { "$ref": "#/$defs/identifier160" },
            "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
            "observation_key": { "$ref": "#/$defs/observationKey" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "key", "description"],
          "properties": {
            "kind": { "const": "handoff_occurred" },
            "key": { "$ref": "#/$defs/identifier160" },
            "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
            "destination": { "$ref": "#/$defs/identifier" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "key", "description"],
          "properties": {
            "kind": { "const": "no_error_events" },
            "key": { "$ref": "#/$defs/identifier160" },
            "description": { "type": "string", "minLength": 1, "maxLength": 2000 }
          }
        }
      ]
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "name",
        "category",
        "severity",
        "description",
        "expected_behavior",
        "fixture",
        "turns",
        "observation_keys",
        "assertions",
        "repetitions",
        "pass_threshold"
      ],
      "properties": {
        "key": { "$ref": "#/$defs/identifier160" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "category": { "$ref": "#/$defs/identifier160" },
        "severity": { "enum": ["critical", "high", "medium", "low"] },
        "description": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "expected_behavior": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "fixture": {
          "type": "object",
          "maxProperties": 1000,
          "additionalProperties": { "$ref": "#/$defs/json" }
        },
        "turns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["content"],
            "properties": {
              "content": { "type": "string", "minLength": 1, "maxLength": 65536 }
            }
          }
        },
        "observation_keys": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/observationKey" }
        },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/assertion" }
        },
        "repetitions": { "type": "integer", "minimum": 1, "maximum": 20 },
        "pass_threshold": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    }
  }
}
